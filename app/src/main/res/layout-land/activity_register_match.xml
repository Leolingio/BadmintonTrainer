<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/registerMatchScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@color/colorPrimaryDark"
    tools:context=".registerMatch.RegisterMatchActivity">

    <RelativeLayout
        android:id="@+id/registerMatchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            app:contentInsetStartWithNavigation="0dp">

            <TextView
                android:id="@+id/registerMatchHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/registerMatchHeadline"
                android:textColor="@color/colorRegisterMatch"
                android:textSize="30sp" />

        </androidx.appcompat.widget.Toolbar>

        <RadioGroup
            android:id="@+id/matchTypeSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_below="@id/toolbar"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/singlesMatchSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Singles Match" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <RadioButton
                android:id="@+id/doublesMatchSelector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="Doubles Match" />
        </RadioGroup>

        <AutoCompleteTextView
            android:id="@+id/team1player1chooser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/matchTypeSelector"
            android:layout_marginStart="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="30dp"
            android:lines="1"
            android:hint="Player 1: ID or name"
            android:minWidth="233dp"
            android:imeOptions="actionNext"
            android:inputType="textPersonName"/>

        <AutoCompleteTextView
            android:id="@+id/team1player2chooser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/team1player1chooser"
            android:layout_marginStart="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:hint="Player 2: ID or name"
            android:minWidth="233dp"
            android:imeOptions="actionNext"
            android:inputType="textPersonName"/>

        <View
            android:id="@+id/playerSeparator1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@id/team1player2chooser"
            android:layout_marginTop="40dp"
            android:background="@android:color/darker_gray"/>

        <AutoCompleteTextView
            android:id="@+id/team2player1chooser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/playerSeparator1"
            android:layout_marginStart="30dp"
            android:layout_marginTop="15dp"
            android:layout_marginEnd="30dp"
            android:hint="Player 3: ID or name"
            android:minWidth="233dp"
            android:imeOptions="actionNext"
            android:inputType="textPersonName"/>

        <AutoCompleteTextView
            android:id="@+id/team2player2chooser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/team2player1chooser"
            android:layout_marginStart="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:hint="Player 4: ID or name"
            android:minWidth="233dp"
            android:imeOptions="actionNext"
            android:inputType="textPersonName"/>

        <LinearLayout
            android:id="@+id/score1Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/team2player2chooser"
            android:layout_marginStart="30dp"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="30dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:textColorHint"
                android:textSize="18sp"
                android:text="@string/firstSet"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/score1Hint">

                <com.sensolic.badmintontrainer.registerMatch.CustomEditText
                    android:id="@+id/score1Team1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:inputType="number"
                    android:maxWidth="150dp"
                    android:minWidth="100dp"
                    android:textAlignment="center"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:text="@string/scoreSeparator"
                android:textSize="20sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/score2Hint">

                <com.sensolic.badmintontrainer.registerMatch.CustomEditText
                    android:id="@+id/score1Team2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:inputType="number"
                    android:maxWidth="150dp"
                    android:minWidth="100dp"
                    android:textAlignment="center"
                    android:imeOptions="actionNext"/>
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/score2Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/score1Container"
            android:layout_marginStart="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:textColorHint"
                android:textSize="18sp"
                android:text="@string/secondSet"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/score1Hint">

                <com.sensolic.badmintontrainer.registerMatch.CustomEditText
                    android:id="@+id/score2Team1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:inputType="number"
                    android:maxWidth="150dp"
                    android:minWidth="100dp"
                    android:textAlignment="center"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:text="@string/scoreSeparator"
                android:textSize="20sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/score2Hint">

                <com.sensolic.badmintontrainer.registerMatch.CustomEditText
                    android:id="@+id/score2Team2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:inputType="number"
                    android:maxWidth="150dp"
                    android:minWidth="100dp"
                    android:textAlignment="center"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/score3Container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/score2Container"
            android:layout_marginStart="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="30dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?android:textColorHint"
                android:textSize="18sp"
                android:text="@string/thirdSet"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/score1Hint">

                <com.sensolic.badmintontrainer.registerMatch.CustomEditText
                    android:id="@+id/score3Team1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:inputType="number"
                    android:maxWidth="150dp"
                    android:minWidth="100dp"
                    android:textAlignment="center"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_margin="10dp"
                android:text="@string/scoreSeparator"
                android:textSize="20sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/score2Hint">

                <com.sensolic.badmintontrainer.registerMatch.CustomEditText
                    android:id="@+id/score3Team2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:inputType="number"
                    android:maxWidth="150dp"
                    android:minWidth="100dp"
                    android:textAlignment="center"
                    android:imeOptions="actionDone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="2" />

        </LinearLayout>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/score3Container"
            android:layout_gravity="center"
            android:layout_marginStart="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="30dp"
            android:text=""
            android:textAlignment="center"
            android:textColor="@color/colorError"
            android:textSize="20sp" />

        <Button
            android:id="@+id/submitButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_below="@id/errorText"
            android:layout_centerInParent="true"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:textAllCaps="false"
            android:text="@string/submitButton" />

    </RelativeLayout>
</ScrollView>